<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Репетитор - Личный кабинет" 
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A4A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C3E50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для заголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для карточки ученика -->
        <Style x:Key="StudentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточки материала -->
        <Style x:Key="MaterialCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (навигация) -->
        <Border x:Name="LeftPanel" Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <!-- Профиль репетитора (шапка) -->
                <Border Background="#34495E" Padding="25" Height="228">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Аватар с инициалами -->
                        <Border Width="80" Height="80" CornerRadius="40" Background="#3498DB" Margin="0,0,0,15">
                            <TextBlock x:Name="AvatarText" 
                                     Text="?" 
                                     FontSize="32" 
                                     FontWeight="Bold" 
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     ToolTip="Загрузка..."/>
                        </Border>

                        <!-- Имя и фамилия репетитора -->
                        <TextBlock x:Name="TutorNameText" 
                                 Text="Загрузка..." 
                                 Foreground="White" 
                                 FontSize="18" 
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"/>

                        <!-- Специализация -->
                        <TextBlock x:Name="TutorSpecText" 
                                 Text="Загрузка..." 
                                 Foreground="#BDC3C7" 
                                 FontSize="12" 
                                 Margin="0,5,0,0"
                                 HorizontalAlignment="Center"/>

                        <!-- Рейтинг -->
                        <TextBlock x:Name="TutorRatingText" 
                                 Text="Рейтинг: 0" 
                                 Foreground="#F1C40F" 
                                 FontSize="13" 
                                 Margin="0,10,0,0"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки навигации -->
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="BtnCalendar" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            Tag="Calendar"
                            Background="#3498DB"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="Календарь занятий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStudents" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            Tag="Students">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="Мои ученики" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMaterials" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            Tag="Materials">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="Учебные материалы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnHistory" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            Tag="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="История занятий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProfile" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            Tag="Profile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="Профиль и настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="#3A4A5A" Margin="25,15"/>

                    <Button x:Name="BtnExit" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnExit_Click"
                            Tag="Exit">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" Margin="0,0,15,0" Width="25"/>
                            <TextBlock Text="Выход" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Нижний колонтитул -->
                <Border Height="1" Background="#3A4A5A" Margin="25,20,25,10"/>
            </StackPanel>
        </Border>

        <!-- Правая панель (контент) -->
        <ScrollViewer Grid.Column="1" 
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#F8F9FA">
            <StackPanel x:Name="ContentPanel" 
                       Margin="25"
                       MinHeight="600">
                <!-- Контент будет добавляться программно -->
                <TextBlock Text="Добро пожаловать!" 
                         Style="{StaticResource SectionHeaderStyle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Выберите раздел в левом меню" 
                                 Foreground="#7F8C8D"
                                 FontSize="16"
                                 HorizontalAlignment="Center"
                                 Margin="50"/>
                        <TextBlock 
                                 Foreground="#95A5A6"
                                 FontSize="14"
                                 Margin="50,20,50,50"
                                 LineHeight="25"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>